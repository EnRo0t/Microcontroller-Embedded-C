int main(void) {
    uint32_t *pClkCtrlReg = (uint32_t*) 0x40023830; /* Puntero del RCC */
    uint32_t *pPortCModReg = (uint32_t*) 0x40020800; /* Puntero del mode register */
    uint32_t *pPortCOutDatReg = (uint32_t*) 0x40020814; /* Puntero del output data register */

    /* Activar reloj del periférico GPIOC en AHB1ENR  */

    uint32_t temp = *pClkCtrlReg; //Almacenamos la dirección en una variable (leer)
    temp = temp | 0x04; // La modificamos con la mascara en una operacion BITWISE (modificar)
    *pClkCtrlReg = temp; // Reescribimos el puntero (volver a escribir)

    /* Se puede hacer en una linea: *pClkCtrlReg = *pClkCtrlReg | 0x04;
