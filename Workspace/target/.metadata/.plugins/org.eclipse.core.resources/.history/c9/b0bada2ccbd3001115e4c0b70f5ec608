    */

    /* Poner el PIN en modo output */

    /* a. Limpiamos los bits 27 y 26 poniendolos a 0 */
    *pPortCModReg &= 0xF3FFFFFF;
    /* b. Seteamos el bit 27 a 1 */
    *pPortCModReg |= 0x08000000;

    void encenderLed() {
        uint16_t i = 60;
        for(i = 0; i < 59; i++) {
            // Encender led
            *pPortCOutDatReg &= 0xEFFF;
            waitOneSec();
